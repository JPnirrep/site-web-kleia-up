# 1. ANTI-CACHE HTML SEULEMENT (pour forcer les mises à jour)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# 2. CACHE LONG POUR ASSETS STATIQUES (images, CSS, JS, polices)
<IfModule mod_expires.c>
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 3. CONFIGURATION SERVEUR
Options -Indexes
AddDefaultCharset UTF-8

# 4. REDIRECTIONS ET REWRITES
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # NE PAS rediriger robots.txt et sitemap.xml (Google exige qu'ils soient servis sans redirect)
    RewriteRule ^(robots\.txt|sitemap\.xml)$ - [L]

    # REDIRECTION HTTP → HTTPS + non-www → www (301 canonical)
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [OR]
    RewriteCond %{HTTP_HOST} ^kleia-up\.fr$ [NC]
    RewriteRule ^(.*)$ https://www.kleia-up.fr/$1 [R=301,L]

    # Correction erreur singulier
    RewriteRule ^entreprise\.html$ https://www.kleia-up.fr/entreprises [R=301,L]

    # Ancien listing du blog (renommé journal.html -> blog.html en 06-2026)
    RewriteRule ^journal\.html$ https://www.kleia-up.fr/blog.html [R=301,L]

    # Ancien dossier journal/ (403 sans fichier index) -> blog.html
    RewriteRule ^journal/?$ https://www.kleia-up.fr/blog.html [R=301,L]

    # Anciens slugs d'articles remplacés par les versions longues (07-2026)
    RewriteRule ^journal/croire-en-lautre(\.html)?$ https://www.kleia-up.fr/journal/croire-en-lautre-un-vrai-moteur.html [R=301,L]
    RewriteRule ^journal/prix-du-silence(\.html)?$ https://www.kleia-up.fr/journal/le-prix-du-silence-est-devenu-trop-lourd-la-verite-brute.html [R=301,L]
    RewriteRule ^journal/on-a-bien-ri(\.html)?$ https://www.kleia-up.fr/journal/alors-sandrina-on-a-bien-ri-aujourdhui.html [R=301,L]
    RewriteRule ^journal/frontiere-limites(\.html)?$ https://www.kleia-up.fr/journal/ce-que-10-ans-a-la-frontiere-mont-appris-sur-tes-limites.html [R=301,L]
    RewriteRule ^journal/tu-voulais-le-dire(\.html)?$ https://www.kleia-up.fr/journal/tu-voulais-le-dire-et-tu-as-remis-ton-masque.html [R=301,L]

    # Fichiers parasites (copies accidentelles) -> page canonique
    # (pattern large : l'encodage %20 de LiteSpeed varie selon les versions)
    RewriteCond %{REQUEST_URI} !^/kit-survie\.html$
    RewriteRule ^kit-survie.*$ https://www.kleia-up.fr/kit-survie.html [R=301,L]
    RewriteRule ^sandbox-entreprises-v2\.html$ https://www.kleia-up.fr/entreprises.html [R=301,L]

    # Landing cadeau-livre (lecteurs du livre) — URL courte pour le QR code du livre
    # (règle R=301 : les réécritures internes [L] sont ignorées sur ce serveur)
    RewriteRule ^cadeau-livre/?$ https://www.kleia-up.fr/cadeau-livre.html [R=301,L]

    # Raccourci inscription newsletter Challenge Juin 2026
    # (rewrite interne [L] ignoré sur ce serveur -> 301 externe)
    RewriteRule ^juin26$ https://www.kleia-up.fr/challenge-juin26.html?source=newsletter [R=301,L]

    # Rediriger /page/ -> /page quand .html existe (évite HTTP 500 Hostinger)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteCond %{DOCUMENT_ROOT}/%1.html -f
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Servir le fichier .html si l'URL est saisie sans extension
    # (test via DOCUMENT_ROOT : sur LiteSpeed, REQUEST_FILENAME n'est pas résolu en chemin FS)
    # NB : la réécriture interne [L] est ignorée par ce serveur -> redirect 301 (comme /cadeau-livre)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
    RewriteRule ^(.*)$ https://www.kleia-up.fr/$1.html [R=301,L]
</IfModule>
