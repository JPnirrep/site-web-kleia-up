# 1. ANTI-CACHE HTML SEULEMENT (pour forcer les mises à jour)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# 2. CACHE LONG POUR ASSETS STATIQUES (images, CSS, JS, polices)
<IfModule mod_expires.c>
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 3. CONFIGURATION SERVEUR
Options -Indexes
AddDefaultCharset UTF-8

# 4. REDIRECTIONS SIMPLES
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # NE PAS rediriger robots.txt (Google exige qu'il soit servi sans redirect)
    RewriteCond %{HTTP_HOST} ^kleia-up\.fr$ [NC]
    RewriteRule ^robots\.txt$ - [L]
    
    # Redirection domaine racine -> www (canonical)
    RewriteCond %{HTTP_HOST} ^kleia-up\.fr$ [NC]
    RewriteRule ^(.*)$ https://www.kleia-up.fr/$1 [R=301,L]

    # Correction erreur singulier
    RewriteRule ^entreprise\.html$ entreprises [R=301,L]

    # Raccourci inscription newsletter Challenge Juin 2026
    RewriteRule ^juin26$ /challenge-juin26.html?source=newsletter [QSA,L]

    # Servir le fichier .html si l'URL est saisie sans
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
