# 1. ANTI-CACHE TOTAL (FORCE UPDATE)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# 2. CONFIGURATION SERVEUR
Options -Indexes
AddDefaultCharset UTF-8

# 3. REDIRECTIONS SIMPLES
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Correction erreur singulier
    RewriteRule ^entreprise\.html$ entreprises [R=301,L]

    # Raccourci inscription newsletter Challenge Juin 2026
    RewriteRule ^juin26$ /challenge-juin26.html?source=newsletter [QSA,L]

    # Servir le fichier .html si l'URL est saisie sans
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
